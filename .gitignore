# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# iOS build artifacts and CocoaPods output.
# NOTE: ios/Podfile and ios/Podfile.lock ARE tracked (not ignored) — they
# pin CocoaPods deps for reproducible EAS / local builds.
ios/build/
ios/build */
ios/Pods/
ios/Pods */
ios/DerivedData/

# macOS case-insensitive FS creates " 2" / " 3" suffixed duplicates when
# `expo prebuild --clean` regenerates ios/. These are always stale junk.
ios/* 2
ios/* 2.*
ios/* 3
ios/* 3.*
ios/Rasvia */
ios/rasvia
ios/rasvia.xcodeproj
ios/rasvia.xcworkspace

*.xcworkspace/xcuserdata/
*.xcodeproj/xcuserdata/
*.xcuserstate
ios/.xcode.env.local
.bundle/
vendor/bundle/
android/

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env*.local

# typescript
*.tsbuildinfo

app-example

# binaries
ngrok.exe

**/tempobook/dynamic/
**/tempobook/storyboards/
**/tempobook/**
node_modules

# build artifacts
*.ipa
*.apk
*.aab
*.log

# Supabase CLI local metadata
supabase/.temp/
