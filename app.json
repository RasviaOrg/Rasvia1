{
  "expo": {
    "name": "Rasvia",
    "slug": "rasvia",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "rasvia",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rasvia",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.rasvia.app",
      "icon": "./assets/images/adaptive-icon.png",
      "backgroundColor": "#0f0f0f",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "monochromeImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0f0f0f"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0f0f0f"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-notifications",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Rasvia uses your location to show nearby Indian restaurants and calculate distances."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Rasvia needs access to your photos to set your profile picture.",
          "cameraPermission": "Rasvia needs camera access to take a profile photo."
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "runtimeVersion": "exposdk:55.0.0",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c01e4c6d-0a50-43c6-aea4-620e85c9dd27"
      }
    },
    "owner": "advait2x"
  }
}
