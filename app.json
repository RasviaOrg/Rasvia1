{
  "expo": {
    "name": "rasvia",
    "slug": "rasvia",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "rasvia",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rasvia.app",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.rasvia.app",
      "versionCode": 1,
      "backgroundColor": "#0f0f0f",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0f0f0f"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0f0f0f"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Rasvia uses your location to show nearby Indian restaurants and calculate distances."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Rasvia needs access to your photos to set your profile picture.",
          "cameraPermission": "Rasvia needs camera access to take a profile photo."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}